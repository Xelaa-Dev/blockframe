{
	"schemaVersion": 1,
	"id": "blockframe",
	"version": "${version}",
	"name": "BlockFrame",
	"description": "A mod that aims to add the Warframe movement / playing experience to Minecraft",
	"authors": [
		"Xela_strawberry"
	],
	"contact": {
		"homepage": "https://github.com/xela-the-proto/blockframe"
	},
	"license": "CC0-1.0",
	"icon": "assets/blockframe/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"xela.blockframe.BlockFrame"
		],
		"client": [
			"xela.blockframe.client.BlockFrameClient"
		],
		"fabric-datagen": [
			"xela.blockframe.client.BlockFrameDataGenerator"
		]
	},
	"mixins": [
		"blockframe.mixins.json",
		{
			"config": "blockframe.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}